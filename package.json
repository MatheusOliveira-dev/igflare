{
  "name": "igflare",
  "version": "0.1.0",
  "description": "TypeScript client for the Instagram private API: login, feeds, publishing, direct messages and insights, with typed results and errors",
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-private-api",
    "instagram-sdk",
    "instagram-client",
    "instagram-insights",
    "instagram-direct",
    "private-api",
    "sdk",
    "api-client",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://matheusoliveira-dev.github.io/igflare/",
  "bugs": {
    "url": "https://github.com/MatheusOliveira-dev/igflare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusOliveira-dev/igflare.git"
  },
  "license": "MIT",
  "author": "Matheus Oliveira",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prose": "node scripts/lint-prose.mjs",
    "guard": "node scripts/check-no-bypass.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dup": "jscpd src",
    "deadcode": "knip",
    "deps": "depcruise src",
    "gen": "node scripts/generate.mjs",
    "gen:check": "node scripts/generate.mjs && git diff --exit-code -- src/generated",
    "api": "api-extractor run --local --verbose",
    "mutation": "stryker run",
    "prepare": "husky",
    "ci": "npm run typecheck && npm run format:check && npm run lint && npm run prose && npm run guard && npm run deps && npm run dup && npm run deadcode && npm run gen:check && npm run coverage && npm run build && npm run api && npm run docs:check",
    "live-check": "node scripts/live-check.mjs",
    "app-build": "node scripts/app-build.ts",
    "docs:api": "typedoc --options typedoc.website.json",
    "docs:dev": "npm run docs:api && vitepress dev website",
    "docs": "npm run docs:api && vitepress build website",
    "docs:preview": "vitepress preview website",
    "docs:check": "typedoc --emit none",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.60.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jscpd": "5.4.3",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitepress": "1.6.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
